# Copia a apps/web/.env.local y rellena. NUNCA subas valores reales.
# URL del proyecto Supabase (pública).
NEXT_PUBLIC_SUPABASE_URL=
# Clave PUBLICABLE (sb_publishable_...). Nunca la clave secreta en la web.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origen público de la web (para comprobar Origin en mutaciones y enlaces de correo).
APP_ORIGIN=http://localhost:3000
# Secreto para seudonimizar identificadores en logs (32+ bytes aleatorios).
LOG_PSEUDONYM_SECRET=
# Asistente educativo (ADR-0025). Una clave de Gemini O de Anthropic: solo en el servidor, nunca NEXT_PUBLIC_.
# Con las dos, gana Gemini salvo ASSISTANT_PROVIDER=anthropic. Usa una clave con facturación activada:
# el uso gratuito de Gemini puede servir para mejorar productos de Google.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Opcional: "gemini" (por defecto) o "anthropic".
ASSISTANT_PROVIDER=
# Opcional: modelo (por defecto gemini-3.8-flash o claude-sonnet-5-5 según el servicio).
ASSISTANT_MODEL=
