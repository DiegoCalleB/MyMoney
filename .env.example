# Copia a apps/web/.env.local y rellena. NUNCA subas valores reales.
# URL del proyecto Supabase (pública).
NEXT_PUBLIC_SUPABASE_URL=
# Clave PUBLICABLE (sb_publishable_...). Nunca la clave secreta en la web.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Origen público de la web (para comprobar Origin en mutaciones y enlaces de correo).
APP_ORIGIN=http://localhost:3000
# Secreto para seudonimizar identificadores en logs (32+ bytes aleatorios).
LOG_PSEUDONYM_SECRET=
# Asistente educativo (ADR-0025). Clave de la API de Anthropic: solo en el servidor, nunca NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Opcional: modelo del asistente (por defecto claude-sonnet-5-5).
ASSISTANT_MODEL=
